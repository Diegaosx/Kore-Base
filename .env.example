# ============================================================================
# 1. APPLICATION & RUNTIME
# ============================================================================
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="pt-BR"

# ============================================================================
# 2. SECURITY, JWT & RATE LIMITING
# ============================================================================
JWT_SECRET="replace-with-64-byte-cryptographic-random-secret-in-production"
JWT_EXPIRES_IN_SECONDS="86400"
WEBHOOK_SECRET="whsec_replace_with_strong_hmac_sha256_secret"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
AUTH_RATE_LIMIT_MAX_REQUESTS="15"
MAX_UPLOAD_SIZE_BYTES="5242880"
ALLOWED_ORIGINS="http://localhost:3000"

# ============================================================================
# 3. DATABASE (POSTGRESQL STANDARD)
# ============================================================================
POSTGRES_ENABLED="false"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="kore_base"
POSTGRES_SSL="false"
POSTGRES_POOL_MAX="10"

# ============================================================================
# 4. OPTIONAL CACHE & QUEUES (REDIS + BULLMQ)
# ============================================================================
REDIS_ENABLED="false"
BULLMQ_ENABLED="false"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
BULLMQ_PREFIX="kore_queue"
BULLMQ_CONCURRENCY="5"

# ============================================================================
# 5. MULTI-LLM INTEGRATIONS (GEMINI, OPENROUTER, LLAMA)
# ============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_DEFAULT_MODEL="gemini-3.8-flash"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="meta-llama/llama-3.3-70b-instruct"

LLAMA_API_BASE_URL="https://api.groq.com/openai/v1"
LLAMA_API_KEY=""
LLAMA_DEFAULT_MODEL="llama-3.3-70b-versatile"

# ============================================================================
# 6. EMAIL & PASSWORD RECOVERY (RESEND & SMTP)
# ============================================================================
MAIL_PROVIDER="resend"
MAIL_FROM="no-reply@kore.dev"
RESEND_API_KEY=""

SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

